<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- LSPosed 模块列表里的“描述”读的是 android:description，不是meta-data -->
    <application
        android:label="@string/app_name"
        android:description="@string/app_desc"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasCode="true">

        <!-- 旧式 LSPosed 识别用，保留兼容 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="@string/app_desc" />
        <meta-data android:name="xposedminversion" android:value="102" />

        <!-- 模块自己的设置界面（Compose + Material3） -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LyricPatch"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
